# Copy file này thành .env.local rồi điền 2 key từ Supabase (Project Settings → API).
# Chưa điền thì app tự chạy bằng localStorage.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tuỳ chọn: bật AI nhập đề trực tiếp trên server.
# Không điền thì app vẫn dùng được nhập marker/CSV/quy tắc và AI ngoài.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
